# VCS
.git
.gitignore

# Node / Bun
**/node_modules
**/.turbo
**/.cache

# Build outputs (rebuilt inside the image)
**/dist
**/build
**/.next
**/out
**/*.tsbuildinfo

# Local env files - never bake secrets into images
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Tests / coverage
**/coverage
**/__snapshots__

# Editor / OS
.DS_Store
.idea
.vscode
*.swp

# Infra (not needed in app image)
packages/terraform-aws

# Logs
*.log
npm-debug.log*
yarn-debug.log*
bun-debug.log*

# Docker meta
Dockerfile
**/Dockerfile
.dockerignore
