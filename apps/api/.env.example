# Database
#   DATABASE_URL          required. Standard Postgres connection string.
#   PG_POOL_MAX           per-process connection pool size (default: 10).
#                         Total RDS connections = PG_POOL_MAX * ECS tasks.
#   PG_IDLE_TIMEOUT       seconds before idle pool connections close (default: 30)
#   PG_CONNECT_TIMEOUT    seconds to wait for a new connection (default: 10)
#   PG_PREPARE            set to "0" if running behind PgBouncer in transaction
#                         pooling mode (disables named prepared statements)
DATABASE_URL=postgresql://localhost:5432/hirely
PG_POOL_MAX=10

# Server
PORT=4000

# Better Auth
#   BETTER_AUTH_SECRET  required. Generate with `openssl rand -base64 48`.
#                       Rotating this invalidates every active session.
#   BETTER_AUTH_URL     fully-qualified API base URL. Must match an
#                       Authorized redirect URI in your Google OAuth client.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000

# Google OAuth (Web client). Optional — when unset / "unset" Better Auth
# silently drops the Google social provider so local dev still boots.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Origins allowed to call this API from a browser. Drives three things:
#   - Better Auth's `trustedOrigins` (CSRF + redirect allowlist for
#     /api/auth/*)
#   - The destination URL of post-sign-in OAuth redirects
#   - The CORS `Access-Control-Allow-Origin` allowlist set in bootstrap.ts.
#     Cross-origin cookies need an explicit origin (never `*`) plus
#     `Access-Control-Allow-Credentials: true`, both of which we configure
#     based on this list.
# Use a comma-separated list to allow multiple origins in production
# (e.g. https://app.hirely.com,https://www.hirely.com).
FRONTEND_URL=http://localhost:3000

# Inngest
#   INNGEST_DEV=1             run in local dev mode (no signing-key check,
#                             talks to the local Inngest dev server). Unset
#                             for production.
#   INNGEST_EVENT_KEY         sign events sent from this app to Inngest Cloud
#   INNGEST_SIGNING_KEY       verify incoming webhook calls from Inngest Cloud
#   ONBOARDING_NUDGE_DELAY    delay before sending the inbox + resume nudge
#                             emails after sign-up. ms-style duration string
#                             ("5d", "1h30m", "30s"). Default 5d. Use a short
#                             value like "30s" in dev to exercise the path.
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
ONBOARDING_NUDGE_DELAY=5d

# HTTP client
#   HTTP_CLIENT  one of: fetch | axios (default: fetch)
#                `axios` is a stub — `bun add axios` and wire it before flipping
HTTP_CLIENT=fetch

# Email
#   EMAIL_PROVIDER         one of: ses | resend | console (default: console)
#                           `console` logs the email to stdout — perfect for
#                           local dev. `ses` is the prod default.
#   EMAIL_FROM              verified sender, e.g. "Hirely <onboarding@hirely.io>"
#   SES_CONFIGURATION_SET   optional. SES config set name; enables
#                           bounce/complaint routing to SNS in prod.
#   AWS_REGION              required when EMAIL_PROVIDER=ses (auto-set in ECS)
#   RESEND_API_KEY          required only when EMAIL_PROVIDER=resend
EMAIL_PROVIDER=console
EMAIL_FROM=onboarding@mindoutreach.com
SES_CONFIGURATION_SET=
RESEND_API_KEY=
