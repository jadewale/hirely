# Database
DATABASE_URL=postgresql://localhost:5432/hirely

# Server
PORT=4000

# Better Auth
#   BETTER_AUTH_SECRET  required. Generate with `openssl rand -base64 48`.
#                       Rotating this invalidates every active session.
#   BETTER_AUTH_URL     fully-qualified API base URL. Must match an
#                       Authorized redirect URI in your Google OAuth client.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000

# Google OAuth (Web client). Optional — when unset / "unset" Better Auth
# silently drops the Google social provider so local dev still boots.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where Better Auth redirects a signed-in user after the OAuth dance.
# Also added to `trustedOrigins` so the frontend can call /api/auth/* with
# credentials.
FRONTEND_URL=http://localhost:3000

# Inngest
#   INNGEST_DEV=1        run in local dev mode (no signing-key check, talks to
#                        the local Inngest dev server). Unset for production.
#   INNGEST_EVENT_KEY    sign events sent from this app to Inngest Cloud
#   INNGEST_SIGNING_KEY  verify incoming webhook calls from Inngest Cloud
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# HTTP client
#   HTTP_CLIENT  one of: fetch | axios (default: fetch)
#                `axios` is a stub — `bun add axios` and wire it before flipping
HTTP_CLIENT=fetch

# Email
#   EMAIL_PROVIDER  one of: resend | ses | console (default: console)
#                   `console` logs the email to stdout — perfect for local dev
#   EMAIL_FROM      verified sender, e.g. "Hirely <onboarding@hirely.io>"
#   RESEND_API_KEY  required when EMAIL_PROVIDER=resend
EMAIL_PROVIDER=console
EMAIL_FROM=onboarding@mindoutreach.com
RESEND_API_KEY=
