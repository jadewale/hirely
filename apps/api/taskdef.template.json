{
  "family": "${TASK_FAMILY}",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "${API_CPU}",
  "memory": "${API_MEMORY}",
  "executionRoleArn": "${EXECUTION_ROLE_ARN}",
  "taskRoleArn": "${TASK_ROLE_ARN}",
  "containerDefinitions": [
    {
      "name": "api",
      "image": "${IMAGE_URI}",
      "essential": true,
      "portMappings": [
        {
          "containerPort": ${API_PORT},
          "hostPort": ${API_PORT},
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "PORT", "value": "${API_PORT}" },
        { "name": "REDIS_HOST", "value": "${REDIS_HOST}" },
        { "name": "REDIS_PORT", "value": "6379" },
        { "name": "FRONTEND_URL", "value": "${FRONTEND_URL}" },
        { "name": "BETTER_AUTH_URL", "value": "${BETTER_AUTH_URL}" },
        { "name": "GOOGLE_REDIRECT_URI", "value": "${GOOGLE_REDIRECT_URI}" },
        { "name": "EMAIL_PROVIDER", "value": "${EMAIL_PROVIDER}" },
        { "name": "EMAIL_FROM", "value": "${EMAIL_FROM}" }
      ],
      "secrets": [
        { "name": "DATABASE_URL", "valueFrom": "${DATABASE_URL_ARN}" },
        { "name": "BETTER_AUTH_SECRET", "valueFrom": "${BETTER_AUTH_SECRET_ARN}" },
        { "name": "GOOGLE_CLIENT_ID", "valueFrom": "${GOOGLE_CLIENT_ID_ARN}" },
        { "name": "GOOGLE_CLIENT_SECRET", "valueFrom": "${GOOGLE_CLIENT_SECRET_ARN}" },
        { "name": "OPENAI_API_KEY", "valueFrom": "${OPENAI_API_KEY_ARN}" },
        { "name": "INNGEST_SIGNING_KEY", "valueFrom": "${INNGEST_SIGNING_KEY_ARN}" },
        { "name": "INNGEST_EVENT_KEY", "valueFrom": "${INNGEST_EVENT_KEY_ARN}" },
        { "name": "RESEND_API_KEY", "valueFrom": "${RESEND_API_KEY_ARN}" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "${LOG_GROUP}",
          "awslogs-region": "${AWS_DEFAULT_REGION}",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
