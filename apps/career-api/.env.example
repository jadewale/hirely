# --- career-api env ------------------------------------------------------
# Copy to `apps/career-api/.env` for local dev. Production values are injected
# by the deployment pipeline as SSM Parameter Store references in the ECS task
# definition. Never commit a real `.env`.

# HTTP port the API listens on. The ALB / local web client target this.
PORT=4100

# Comma-separated list of allowed frontend origins. Drives the CORS allowlist
# (and, once RR-005 lands, Better Auth's trustedOrigins). Single value in dev,
# comma-separated in prod.
FRONTEND_URL=http://localhost:3100

# PostgreSQL connection string for @career/db (RR-003). For local dev, start
# the bundled Postgres with `docker compose up -d career-postgres` (repo root).
# In production this is injected from SSM by the deployment pipeline.
DATABASE_URL=postgres://career:career@127.0.0.1:5444/career

# Connection-pool tuning (optional; sensible defaults in @career/db). Total RDS
# connections used = PG_POOL_MAX * number of ECS tasks.
# PG_POOL_MAX=10
# PG_IDLE_TIMEOUT=30
# PG_CONNECT_TIMEOUT=10
# Set PG_PREPARE=0 only if running behind PgBouncer in transaction-pooling mode.
# PG_PREPARE=1

# --- auth (RR-005, Better Auth) ------------------------------------------
# Session-signing secret. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Public base URL of this API (used by Better Auth for callbacks + cookies).
BETTER_AUTH_URL=http://localhost:4100

# Production cookie settings: in prod (NODE_ENV=production) the session cookie
# is Secure + SameSite=None so it survives the cross-subdomain browser flow
# (app.career.<domain> -> api.career.<domain>). Set COOKIE_DOMAIN to the shared
# parent so the cookie is valid across both subdomains, e.g.:
# COOKIE_DOMAIN=.career.mindoutreach.com

