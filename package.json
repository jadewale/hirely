{
  "name": "hirely",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "career:db:up": "docker compose up -d career-postgres",
    "career:auth-generate": "bunx @better-auth/cli@latest generate --config apps/career-api/src/lib/auth.ts --output packages/career-db/src/schema/auth.ts --yes",
    "career:db:generate": "bun run --cwd packages/career-db db:generate",
    "career:db:migrate": "bun run --cwd packages/career-db db:migrate",
    "career:db:seed": "bun run --cwd apps/career-api seed",
    "career:db:studio": "bun run --cwd packages/career-db db:studio"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.7",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
