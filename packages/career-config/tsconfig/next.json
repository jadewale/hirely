{
  "$schema": "https://json.schemastore.org/tsconfig",
  "_comment": "Standalone base for the Next.js app. Mirrors apps/career-web's compiler needs (DOM libs, bundler resolution, JSX, next plugin).",
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [{ "name": "next" }]
  }
}
