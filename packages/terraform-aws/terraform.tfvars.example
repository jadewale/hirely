aws_region               = "us-east-1"
project_name             = "hirely"
environment              = "prod"

# Allowed web origins (comma-separated). Drives BOTH the API's CORS
# allowlist AND Better Auth's trustedOrigins. Example with multiple
# environments: "https://app.hirely.com,http://localhost:3000"
frontend_url             = "https://app.hirely.com"

# Domains. The API lives in this AWS account (ALB + ACM); the web client
# is hosted on Vercel and we only own its DNS record here.
# route53_zone_id        = "Z0123456789ABCDEFGHIJ"
# api_domain_name        = "api.hirely.com"
# web_domain_name        = "app.hirely.com"

# Container settings
api_image_tag            = "latest"
api_desired_count        = 1
api_cpu                  = 512
api_memory               = 1024

# Database
db_name                  = "hirely"
db_username              = "hirely"
db_instance_class        = "db.t3.micro"

# Redis
redis_node_type          = "cache.t4g.micro"

# Secrets — REPLACE these with real values before running terraform apply
# Generate auth secret: openssl rand -base64 64
better_auth_secret       = "replace-with-a-long-random-secret"
google_client_id         = "your-google-client-id.apps.googleusercontent.com"
google_client_secret     = "your-google-client-secret"
openai_api_key           = "sk-your-openai-api-key"

# Email
# email_provider          = "ses"   # default; alternatives: resend | console
# email_from              = "Hirely <noreply@hirely.com>"
# ses_mail_domain         = "hirely.com"   # null/omit to skip SES provisioning
# resend_api_key          = ""              # only needed if email_provider="resend"

# CI/CD
github_repo              = "jadewale/hirely"
github_branch            = "main"
codepipeline_enabled     = true

# ── career-platform (second app in this monorepo) ────────────────────────────
# career-api deploys via its own ECS service + pipeline (career_service.tf /
# career_cicd.tf), reusing the shared VPC, ECS cluster, and RDS instance.
career_frontend_url          = "http://localhost:3100"
# career_api_domain_name     = "api.careerplatform.com"
# career_web_domain_name     = "app.careerplatform.com"
career_db_name               = "career"   # create once on the shared RDS: CREATE DATABASE career;
career_api_cpu               = 512
career_api_memory            = 1024
career_api_desired_count     = 1

# Secrets — REPLACE before apply. Generate: openssl rand -base64 64
career_better_auth_secret    = "replace-with-a-long-random-secret"
# Optional until the relevant RR ticket lands (default to empty -> stored as "unset"):
# career_stripe_secret_key     = "sk_live_..."
# career_stripe_webhook_secret = "whsec_..."
# career_inngest_signing_key   = "signkey-prod-..."
# career_inngest_event_key     = "..."
