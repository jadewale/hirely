aws_region               = "us-east-1"
project_name             = "hirely"
environment              = "prod"

# Allowed web origins (comma-separated). Drives BOTH the API's CORS
# allowlist AND Better Auth's trustedOrigins. Example with multiple
# environments: "https://app.hirely.com,http://localhost:3000"
frontend_url             = "https://app.hirely.com"

# Domains. The API lives in this AWS account (ALB + ACM); the web client
# is hosted on Vercel and we only own its DNS record here.
# route53_zone_id        = "Z0123456789ABCDEFGHIJ"
# api_domain_name        = "api.hirely.com"
# web_domain_name        = "app.hirely.com"

# Container settings
api_image_tag            = "latest"
api_desired_count        = 1
api_cpu                  = 512
api_memory               = 1024

# Database
db_name                  = "hirely"
db_username              = "hirely"
db_instance_class        = "db.t3.micro"

# Redis
redis_node_type          = "cache.t4g.micro"

# Secrets — REPLACE these with real values before running terraform apply
# Generate auth secret: openssl rand -base64 64
better_auth_secret       = "replace-with-a-long-random-secret"
google_client_id         = "your-google-client-id.apps.googleusercontent.com"
google_client_secret     = "your-google-client-secret"
openai_api_key           = "sk-your-openai-api-key"

# Email
# email_provider          = "ses"   # default; alternatives: resend | console
# email_from              = "Hirely <noreply@hirely.com>"
# ses_mail_domain         = "hirely.com"   # null/omit to skip SES provisioning
# resend_api_key          = ""              # only needed if email_provider="resend"

# CI/CD
github_repo              = "jadewale/hirely"
github_branch            = "main"
codepipeline_enabled     = true
